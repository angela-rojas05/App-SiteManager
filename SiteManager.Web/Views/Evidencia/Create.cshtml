@model SiteManager.Domain.Models.Evidencia
@{
    ViewData["Title"] = "Nueva Evidencia";
}

<div class="sm-form-card">
    <div class="sm-form-header">
        <h2><i class="fa-solid fa-camera" style="color:#0284c7;margin-right:8px;"></i>Registrar Nueva Evidencia</h2>
        <p>Añade documentación fotográfica al expediente</p>
    </div>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="sm-field-error" style="padding:12px 24px;"></div>
        <div class="sm-form-body">
            <div class="sm-field">
                <label asp-for="Titulo">Título *</label>
                <input asp-for="Titulo" placeholder="Ej. Foto daño en techo" />
                <span asp-validation-for="Titulo" class="sm-field-error"></span>
            </div>
            <div class="sm-field">
                <label asp-for="Descripcion">Descripción</label>
                <textarea asp-for="Descripcion" placeholder="Describe el contenido del archivo..."></textarea>
                <span asp-validation-for="Descripcion" class="sm-field-error"></span>
            </div>
            <div class="sm-field">
                <label for="imagenFile">Imagen *</label>
                <input type="file" id="imagenFile" name="imagenFile" accept=".jpg,.jpeg,.png,.webp" />
                <span class="sm-field-error">@Html.ValidationMessage("imagenFile")</span>
                <small style="color:var(--muted-fg);">Formatos permitidos: JPG, PNG, WEBP. Máximo 5 MB.</small>
            </div>
            <div class="sm-field">
                <label asp-for="SiniestroId">Siniestro *</label>
                <select asp-for="SiniestroId" asp-items='new SelectList(ViewBag.Siniestros, "Id", "TipoDanio")'>
                    <option value="">— Seleccione un siniestro —</option>
                </select>
                <span asp-validation-for="SiniestroId" class="sm-field-error"></span>
            </div>
        </div>
        <div class="sm-form-footer">
            <button type="submit" class="btn-sm-primary"><i class="fa-solid fa-floppy-disk"></i> Guardar</button>
            <a asp-action="Index" class="btn-sm-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}